# BubbleHead reference environment values
# The current application reads config.py and ui.py directly.
# Keep this file in sync if you later add os.environ-based configuration.

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models
EMBED_MODEL=nomic-embed-text
LLM_MODEL=mistral:latest
LLM_TEMPERATURE=0.3

# ChromaDB
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=bubblehead

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval
TOP_K_CANDIDATES=10
TOP_K_FINAL=6
TOKEN_BUDGET=5000

# Gap analysis
GAP_CONFIDENCE_THRESHOLD=0.6
GAP_MAX_ITERATIONS=2

# Web app
UI_HOST=0.0.0.0
UI_PORT=7860
